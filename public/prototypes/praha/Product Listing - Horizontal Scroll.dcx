  }
  scrollSelectMode() {
    return (this.props.listMode ?? "Two columns — click to select").indexOf("Single") === 0;
  }
  computeSel() {
    if (this._rafPending) return;
    this._rafPending = true;
    requestAnimationFrame(() => {
      this._rafPending = false;
      const list = this._list;
      if (!list) return;
      if (!this._secs || !this._secs.length || !this._secs[0].isConnected) {
