  tween(el, axis, target, ms) {
    const key = axis === "x" ? "scrollLeft" : "scrollTop";
    const from = el[key];
    const dist = target - from;
    if (Math.abs(dist) < 1) return;
    if (document.visibilityState === "hidden") { el[key] = target; return; }
    const t0 = performance.now();
    const step = (now) => {
      const k = Math.min(1, (now - t0) / (ms || 300));
      const e = k < 0.5 ? 2 * k * k : 1 - Math.pow(-2 * k + 2, 2) / 2;
      el[key] = from + dist * e;
