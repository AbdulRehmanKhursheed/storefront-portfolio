      "REFRESHERS": "./uploads/Group 1410103972.png"
    };
    sections.forEach((s) => { s.headImg = HEAD[s.label] || ""; s.hasHeadImg = !!HEAD[s.label]; s.noHeadImg = !HEAD[s.label]; });
    if (this._secKey !== q) { this._secKey = q; this._secs = null; this._activeCat = null; }
    const addonData = [
      { id: "chicken", label: "Add grilled chicken", price: 450 },
      { id: "prawns", label: "Add prawns", price: 650 },
      { id: "cheese", label: "Extra cheese", price: 250 },
      { id: "fries", label: "Side of fries", price: 395 },
      { id: "bread", label: "Garlic bread", price: 345 },
      { id: "coffee", label: "Iced coffee", price: 695 }
    ];
    const itemKey = sel.name;
    const pickedBy = this.state.pickedBy || {};
    const noteBy = this.state.noteBy || {};
    const committed = this.state.committed || {};
    const picked = pickedBy[itemKey] || [];
    const note = noteBy[itemKey] || "";
    const sig = (p, n) => p.slice().sort().join("|") + "§" + (n || "").trim();
    const setPicked = (fn) => this.setState(s => {
      const map = s.pickedBy || {};
      return { pickedBy: { ...map, [itemKey]: fn(map[itemKey] || []) } };
    });
    const addons = addonData.map(a => ({
      id: a.id,
      label: a.label,
      optionLabel: (picked.indexOf(a.id) > -1 ? "✓  " : "") + a.label + "  +Rs. " + a.price,
      priceLabel: "Rs. " + a.price,
      on: picked.indexOf(a.id) > -1,
      off: picked.indexOf(a.id) < 0,
      toggle: () => setPicked(list => list.indexOf(a.id) > -1 ? list.filter(x => x !== a.id) : list.concat([a.id]))
    }));
    const base = parseInt(String(sel.price || "0").replace(/[^0-9]/g, ""), 10) || 0;
    const qty = Math.max(1, this.state.qty);
    const total = (base + addonData.reduce((sum, a) => sum + (picked.indexOf(a.id) > -1 ? a.price : 0), 0)) * qty;
    const addonSum = addonData.reduce((sum, a) => sum + (picked.indexOf(a.id) > -1 ? a.price : 0), 0);
    const unitPriceLabel = "Rs. " + (base + addonSum).toLocaleString("en-US");
    const addedQty = this.state.added[sel.name] || 0;
    const FREE_AT = this.props.freeAbove ?? 5000;
    const DELIV_FEE = this.props.deliveryFee ?? 250;
    const cartItems = Object.keys(this.state.added).filter(n => this.state.added[n] > 0).map(n => {
      const di = data.findIndex(x => x.name === n);
      const d = data[di] || {};
      const img = d.img || pool[Math.max(0, di) % pool.length];
      const nPicked = (this.state.pickedBy || {})[n] || [];
      const unit = (parseInt(String(d.price || "0").replace(/[^0-9]/g, ""), 10) || 0)
        + addonData.reduce((sum, a) => sum + (nPicked.indexOf(a.id) > -1 ? a.price : 0), 0);
      const qn = this.state.added[n];
      return {
        name: n, img: R(img), rawImg: img, unit, qn, qty: String(qn),
        unitLabel: "Rs. " + unit.toLocaleString("en-US"),
        line: "Rs. " + (unit * qn).toLocaleString("en-US"),
        inc: () => this.setState(s => ({ added: { ...s.added, [n]: (s.added[n] || 0) + 1 } })),
        dec: () => this.setState(s => { const v = (s.added[n] || 0) - 1; const nx = { ...s.added }; if (v <= 0) delete nx[n]; else nx[n] = v; return { added: nx }; })
      };
    });
    const subtotal = cartItems.reduce((a, c) => a + c.unit * c.qn, 0);
    const freeDel = subtotal >= FREE_AT && subtotal > 0;
    const delivFee = freeDel ? 0 : DELIV_FEE;
    const bestSellers = ["Creamy Sundried Tomato Rigatoni", "Nutella French Toast", "Ja Ja Jamaica Burger", "Prahas Euro Club Sandwich", "Quinoa & Feta Cheese"].map(n => {
      const di = data.findIndex(x => x.name === n);
      const d = data[di];
      return {
        name: n, img: R(d.img || pool[di % pool.length]), priceLabel: d.price,
        add: () => this.setState(s => ({ added: { ...s.added, [n]: (s.added[n] || 0) + 1 } }))
      };
    });
    const cats = [...new Set(data.map(d => d.cat))].map(label => ({
      id: label + "|" + (this.state.cat || sel.cat),
      label,
      active: label === (this.state.cat && this.state.cat !== "ALL" ? this.state.cat : sel.cat),
      inactive: label !== (this.state.cat && this.state.cat !== "ALL" ? this.state.cat : sel.cat),
      pick: () => {
        this._userPicked = true;
        const idx = products.findIndex(p => p.cat === label);
        if (idx >= 0) this.setState({ sel: idx });
      }
    }));
    return {
      products, sections, sel, showBarcode, ready: true, cats,
      listMode: this.scrollSelectMode() ? "single" : "two",
      noResults: products.length === 0,
      showTicketPanel: !cardMode && products.length > 0,
      ticketTiles: !cardMode,
      cardTiles: cardMode,
      stageMode: cardMode ? "cards" : "ticket",
      noQuery: !q,
      hasQuery: !!q,
      q,
      onSearch: (e) => { this.setState({ q: e.target.value, sel: 0 }); this.resetList(); },
      clearSearch: (e) => { e.preventDefault(); this.setState({ q: "", sel: 0 }); this.resetList(); },
      selBars: sel.code ? mkBars(sel.code, 34) : [],
      count: String(products.length).padStart(2, "0"),
      tileCols: showBarcode ? "clamp(38px, 4.4vw, 58px) 1px minmax(90px, 1fr) 1px clamp(64px, 8vw, 116px)" : "minmax(0, 1fr) 1px clamp(84px, 7vw, 128px)",
      listRef: (el) => { this._list = el; },
      onListScroll: (e) => {
        if (e && e.currentTarget) this._list = e.currentTarget;
        this.computeSel();
      },
      sheetOpen: this.state.sheetOpen,
      listOverflow: this.state.sheetOpen ? "hidden" : "auto",
      wiggleAnim: this.state.wiggle === 0 ? "none" : (this.state.wiggle % 2 ? "wiggle-a" : "wiggle-b"),
      addons: addons,
      total: "Rs. " + total.toLocaleString("en-US"),
      addCount: String(qty + this.state.picked.length),
      qty: String(qty),
      incQty: () => this.setState(s => ({ qty: Math.min(20, s.qty + 1) })),
      decQty: () => this.setState(s => ({ qty: Math.max(1, s.qty - 1) })),
      addedQty: String(addedQty),
      cartCount: String(Object.values(this.state.added).reduce((a, b) => a + b, 0)),
      hasCart: Object.values(this.state.added).reduce((a, b) => a + b, 0) > 0,
      cartOpen: !!this.state.cartOpen && !inPanelCart,
      panelCart: !!this.state.cartOpen && inPanelCart,
      openCart: (e) => { e.preventDefault(); this.setState({ cartOpen: true }); },
      closeCart: (e) => { e.preventDefault(); this.setState({ cartOpen: false }); },
      cartItems, bestSellers,
      cartEmpty: cartItems.length === 0,
      freeDel, notFreeDel: !freeDel,
      toFree: "RS. " + Math.max(0, FREE_AT - subtotal).toLocaleString("en-US"),
      freePct: Math.min(100, Math.round(subtotal / FREE_AT * 100)) + "%",
      subtotalLabel: "Rs. " + subtotal.toLocaleString("en-US"),
      delivLabel: freeDel ? "FREE" : "Rs. " + delivFee.toLocaleString("en-US"),
      cartTotalLabel: "Rs. " + (subtotal + delivFee).toLocaleString("en-US"),
      goCheckout: (e) => {
        try { localStorage.setItem("praha-cart", JSON.stringify(cartItems.map(c => ({ name: c.name, img: c.rawImg || c.img, unit: c.unit, qty: c.qn })))); } catch (err) {}
        if (this.props.onCheckout) { if (e && e.preventDefault) e.preventDefault(); this.props.onCheckout(); }
      },
      isAdded: addedQty > 0,
      notAdded: addedQty === 0,
      modalOpen: !!this.state.modalOpen,
      closeModal: (e) => { e.preventDefault(); this.setState({ modalOpen: false, picked: [], note: "", qty: 1 }); },
      confirmModal: (e) => {
        e.preventDefault();
        this.setState(s => ({
          modalOpen: false, picked: [], note: "", qty: 1,
          added: { ...s.added, [sel.name]: (s.added[sel.name] || 0) + qty }
        }));
      },
      onNote: (e) => { const v = e.target.value; this.setState(s => ({ noteBy: { ...(s.noteBy || {}), [itemKey]: v } })); },
      noteVal: note,
      unitPriceLabel,
      addonSelect: "",
      pickedCount: picked.length ? picked.length + " selected" : "",
      addonSummary: picked.length ? addonData.filter(a => picked.indexOf(a.id) > -1).map(a => a.label.replace(/^Add /, "").replace(/^Extra /, "Extra ")).join(", ") : "Select add-ons",
      addonSummaryColor: picked.length ? "#14110F" : "#A9A198",
      onPickAddon: (e) => {
        const id = e.target.value;
        if (!id) return;
        setPicked(list => list.indexOf(id) > -1 ? list.filter(x => x !== id) : list.concat([id]));
      },
      isDirty: addedQty > 0 && committed[itemKey] !== undefined && committed[itemKey] !== sig(picked, note),
      isAddedClean: addedQty > 0 && (committed[itemKey] === undefined || committed[itemKey] === sig(picked, note)),
      updateOrder: (e) => {
        if (e && e.preventDefault) e.preventDefault();
        this.setState(s => ({ committed: { ...(s.committed || {}), [itemKey]: sig(picked, note) } }));
      },
      closeSheet: (e) => { e.preventDefault(); this.setState({ sheetOpen: false, qty: 1 }); },
      confirmAdd: (e) => {
        e.preventDefault();
        this.setState(s => ({
          sheetOpen: false, picked: [], note: "", qty: 1,
          added: { ...s.added, [sel.name]: (s.added[sel.name] || 0) + qty }
        }));
      },
      addToOrder: (e) => {
        e.preventDefault();
        if (this._list) this._lockTop = this._list.scrollTop;
        this.setState(s => ({
          added: { ...s.added, [sel.name]: (s.added[sel.name] || 0) + 1 },
          committed: { ...(s.committed || {}), [itemKey]: sig(picked, note) }
        }));
      },
      addedInc: (e) => {
        if (e && e.preventDefault) e.preventDefault();
        this.setState(s => ({ added: { ...s.added, [sel.name]: Math.min(20, (s.added[sel.name] || 0) + 1) } }));
      },
      addedDec: (e) => {
        if (e && e.preventDefault) e.preventDefault();
        this.setState(s => ({ added: { ...s.added, [sel.name]: Math.max(0, (s.added[sel.name] || 0) - 1) } }));
      }
    };
  }
}
</script>
</body>
</html>
