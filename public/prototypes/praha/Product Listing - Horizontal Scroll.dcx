    const nav = document.querySelector("[data-catnav]");
    const pill = nav && nav.querySelector('[data-cat-pill="active"]');
    if (!nav || !pill) return;
    const nr = nav.getBoundingClientRect();
    const pr = pill.getBoundingClientRect();
    const pad = 64;
    let target = nav.scrollLeft + (pr.left + pr.width / 2) - (nr.left + nr.width / 2);
    const max = nav.scrollWidth - nav.clientWidth;
    target = Math.max(0, Math.min(target, max));
    const rightGap = nr.right - pad - (pr.right + (target - nav.scrollLeft));
    if (rightGap < 0) target = Math.max(0, Math.min(target - rightGap, max));
    this.tween(nav, "x", target, 280);
  }
  tiles() {
    if (!this._list) this._list = document.querySelector("[data-sku-list]");
    const list = this._list;
    if (!list) return [];
    return Array.from(list.children).filter(el => el.hasAttribute && el.hasAttribute("data-tile"));
