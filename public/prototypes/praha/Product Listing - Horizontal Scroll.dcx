    this._mq.addEventListener("change", this._onMq);
    if (this._mq.matches) this.setState({ isMobile: true });
    setTimeout(() => {
      if (!this._list) this._list = document.querySelector("[data-sku-list]");
      if (this._list && !this._bound) {
