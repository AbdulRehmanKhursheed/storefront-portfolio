class Component extends DCLogic {
  state = { sel: 0, flip: 0, cat: "ALL", q: "", scrolled: false, sheetOpen: false, picked: [], note: "", wiggle: 0, qty: 1, added: {}, modalOpen: false, isMobile: false, cartOpen: false };
  resetList() {
    if (this._list) this._list.scrollTop = 0;
  }
  applyFontTheme() {
    const classic = (this.props.fontTheme || "").indexOf("Classic") === 0;
    let tag = document.getElementById("pl-font-theme");
    if (classic) {
      if (!tag) { tag = document.createElement("style"); tag.id = "pl-font-theme"; document.head.appendChild(tag); }
      tag.textContent = `
        [data-fontroot], [data-fontroot] *:not([style*="Plex Mono"]):not(p) { font-family: 'Lato', sans-serif !important; }
        [data-fontroot] p { font-family: 'EB Garamond', Georgia, serif !important; }
        [data-fontroot] h2, [data-fontroot] h3, [data-fontroot] [data-menu-head] span { font-weight: 900 !important; letter-spacing: -0.02em !important; }
      `;
    } else if (tag) { tag.remove(); }
  }
  componentDidMount() {
    this.applyFontTheme();
    this._onWinScroll = () => this.computeSel();
