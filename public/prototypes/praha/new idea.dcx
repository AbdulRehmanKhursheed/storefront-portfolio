<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<style>
  @font-face { font-family: 'The Hantwels'; src: url('./uploads/TheHantwels-zrw8l.ttf') format('truetype'); font-weight: 400; font-display: swap; }
  @font-face { font-family: 'Awaline'; src: url('./uploads/AwalineDemoRegular-wozjn.ttf') format('truetype'); font-weight: 400; font-display: swap; }
  html, body { margin: 0; padding: 0; background: #F1ECEB; }
  * { box-sizing: border-box; }
  a { color: #914B4C; text-decoration: none; }
  a:hover { color: #5F1E1F; }
</style>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;700&amp;display=swap" rel="stylesheet">
</helmet>
<div style="width: 100%; background: #F1ECEB;">
<header style="position: sticky; top: 0; z-index: 50; width: 100%; height: 89px; overflow: hidden; background-color: rgb(255,255,255);">
  <div aria-hidden="true" style="position: absolute; inset: 0; background: url('./uploads/TILES.png') left center / auto 100% repeat-x;"></div>
  <div style="position: absolute; left: 76px; top: 0; height: 89px; display: flex; align-items: center; gap: 26px;">
    <a href="#home" style="display: flex; align-items: center;">
      <img src="./assets/logo-praha.png" alt="Caffè Praha" style="height: 41px; width: auto; display: block;">
    </a>
    <button style="display: flex; align-items: center; gap: 12px; border: 0; border-radius: 12px; padding: 10px 20px 10px 14px; cursor: pointer; font-family: Montserrat, sans-serif; text-align: left; background-color: #FFFFFFBF" style-hover="background: rgb(255,255,255);">
      <svg width="19" height="19" viewBox="0 0 24 24" fill="none">
        <path d="M12 21s7-6.1 7-11a7 7 0 1 0-14 0c0 4.9 7 11 7 11z" stroke="rgb(145,75,76)" stroke-width="1.6"></path>
        <circle cx="12" cy="10" r="2.6" stroke="rgb(145,75,76)" stroke-width="1.6"></circle>
      </svg>
      <span style="display: flex; flex-direction: column; gap: 1px;">
        <span style="font-size: 12px; color: rgb(169,161,152);">Deliver to</span>
        <span style="font-size: 14px; font-weight: 500; color: rgb(95,30,31);">Clifton, Karachi</span>
      </span>
    </button>
  </div>
</header>
<div ref="{{ scaleWrapRef }}" style="width: 100%; overflow: hidden;">
<div ref="{{ scaleInnerRef }}" style="width: 1512px; transform-origin: top left;">


<div data-screen-label="Praha Hero" style="position: relative; width: 1512px; height: 982px; overflow: hidden; background-color: #F1ECEB; flex: none; font-family: Montserrat, sans-serif;">
  <div aria-hidden="true" style="position: absolute; left: 0; top: 0; transform: matrix(0,-1,1,0,0,982); transform-origin: 0 0; width: 1118.252px; height: 1565.688px; opacity: 0.2; background: url('./assets/hero-limewash-bg.png') center / cover no-repeat;"></div>
  <div aria-hidden="true" style="position: absolute; left: 895.58px; top: 117.99px; width: 705.015px; height: 891.557px; border-radius: 50%; background-color: rgba(200,200,200,0.53); filter: blur(28px);"></div>
  <img src="./uploads/table-63e14c45.png" alt="Table with today's items" style="position: absolute; left: 923.31px; top: 118px; width: 891px; height: 891px; transform: rotate({{ tableDeg }}deg); transition: transform 1400ms cubic-bezier(0.4, 0, 0.2, 1); will-change: transform;">
  <img src="./uploads/plants.png" alt="" style="position: absolute; left: 0; top: 0; height: 982px; width: auto; pointer-events: none;">
  <div data-annotations="1" style="position: absolute; inset: 0; pointer-events: none; opacity: {{ annOpacity }}; transform: {{ annShift }}; transition: opacity {{ annDur }} {{ annEase }} {{ annDelay }}, transform {{ annDur }} {{ annEase }} {{ annDelay }};">
  <span style="position: absolute; left: 759px; top: 195px; width: 229px; transform: rotate(-8deg); font-family: 'The Hantwels', cursive; font-weight: 400; font-size: 24px; text-align: center; line-height: 1.2; color: rgb(104,104,104);">Creamy tomato rigattoni</span>
  <img src="./assets/arrow-4024-2.svg" alt="" style="position: absolute; left: 0; top: 0; transform: matrix(0.684,0.729,0.729,-0.684,999.782,196.428); transform-origin: 0 0; width: 156.766px; height: 71.754px;">
  <span style="position: absolute; left: 1259px; top: 200px; width: 229px; transform: rotate(-5deg); font-family: 'The Hantwels', cursive; font-weight: 400; font-size: 24px; text-align: center; line-height: 1.2; color: rgb(104,104,104);">Creamy tomato rigattoni</span>
  <svg width="18.053" height="67.053" viewBox="0 0 18.053 67.053" fill="rgb(104,104,104)" style="position: absolute; left: 1406.1px; top: 285.05px;">
    <path d="M 18.053 67.053 L 19.54 61.474 L 13.965 62.975 L 18.053 67.053 Z M 0 0 L -0.483 0.13 L 16.4 62.837 L 16.883 62.707 L 17.366 62.577 L 0.483 -0.13 L 0 0 Z"></path>
  </svg>
  <span style="position: absolute; left: 722px; top: 738px; width: 229px; transform: rotate(-8deg); font-family: 'The Hantwels', cursive; font-weight: 400; font-size: 24px; text-align: center; line-height: 1.2; color: rgb(104,104,104);">Creamy tomato rigattoni</span>
  <img src="./assets/arrow-4024.svg" alt="" style="position: absolute; left: 845.17px; top: 819.83px; width: 228.155px; height: 102.455px;">
</div>
  <div style="position: absolute; left: 209.38px; top: 370px; width: 665px; display: flex; flex-direction: column; gap: 0;">
    <h1 style="margin: 0; width: 664px; font-family: 'Awaline', serif; font-weight: 400; font-size: 48px; line-height: 1; color: rgb(145,75,76)">From the Heart of Prague</h1>
    <p style="margin: 8px 0 0 0; width: 580px; font-family: Montserrat; font-weight: 400; font-size: 16px; line-height: 24.4px; color: rgb(95,30,31); text-wrap: pretty">Since 2017, a Prague-inspired café in Karachi, Islamabad and Lahore — built for lingering.</p>
    <a href="#menu" style="margin-top: 32px; width: 240px; height: 60px; display: flex; align-items: center; justify-content: center; border-radius: 12px; background-color: rgb(233,187,188); font-family: Montserrat, sans-serif; font-weight: 600; font-size: 16px; color: rgb(145,75,76)" style-hover="background-color: rgb(224,170,172);">See Menu</a>
  </div>
  
</div>
<div data-screen-label="Announcements" style="width: 100%; height: 52px; display: flex; align-items: center; justify-content: center; gap: 14px; background-color: rgb(145,75,76); font-family: Montserrat, sans-serif;">
  <span style="font-size: 15px; font-weight: 700; letter-spacing: 0.08em; color: rgb(233,187,188); text-transform: uppercase;">Announcement</span>
  <span style="width: 1px; height: 18px; background: rgba(233,187,188,0.5);"></span>
  <span style="font-size: 15px; color: rgb(254,249,247);">Weekend brunch now served till 3pm — Karachi, Islamabad &amp; Lahore</span>
</div>
<div data-screen-label="Bank Discounts" style="width: 100%; padding: 56px 48px; background-color: #F1ECEB;">
  <img src="./uploads/bank discounts-09ac40e4.png" alt="Bank discounts — up to 50% off with partner bank cards" style="display: block; width: 100%; height: auto;">
</div>
</div>
</div>
</div>
</x-dc>
<script type="text/x-dc" data-dc-script data-props="{&quot;$preview&quot;:{&quot;width&quot;:1512,&quot;height&quot;:982},&quot;autoSpin&quot;:{&quot;editor&quot;:&quot;boolean&quot;,&quot;default&quot;:true,&quot;tsType&quot;:&quot;boolean&quot;,&quot;section&quot;:&quot;Table rotation&quot;},&quot;spinInterval&quot;:{&quot;editor&quot;:&quot;range&quot;,&quot;default&quot;:6,&quot;min&quot;:3,&quot;max&quot;:15,&quot;step&quot;:1,&quot;unit&quot;:&quot;s&quot;,&quot;tsType&quot;:&quot;number&quot;,&quot;section&quot;:&quot;Table rotation&quot;}}">
class Component extends DCLogic {
  state = { deg: 0, shown: true };
  componentDidMount() {
    this.schedule();
    this._onResize = () => this.computeScale();
    window.addEventListener("resize", this._onResize);
    setTimeout(() => this.computeScale(), 60);
    window.addEventListener("load", this._onResize);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(() => this.computeScale());
  }
  computeScale() {
    const wrap = this._wrap, inner = this._inner;
    if (!wrap || !inner) return;
    const avail = wrap.clientWidth;
    const s = avail / 1512;
    inner.style.transform = "scale(" + s + ")";
    const h = Math.round(inner.scrollHeight * s);
    wrap.style.height = h + "px";
  }
  componentWillUnmount() { clearTimeout(this._t1); clearTimeout(this._t2); clearTimeout(this._t3); clearInterval(this._t4); window.removeEventListener("resize", this._onResize); }
  schedule() {
    clearTimeout(this._t1);
    const interval = (this.props.spinInterval ?? 6) * 1000;
    this._t1 = setTimeout(() => this.spin(), interval);
  }
  spin() {
    if ((this.props.autoSpin ?? true) === false) { this.schedule(); return; }
    /* exit: labels accelerate out, then the table turns, then labels decelerate back in */
    this.setState({ shown: false });
    this._t2 = setTimeout(() => {
      this.setState(s => ({ deg: s.deg + 360 }));
      this._t3 = setTimeout(() => { this.setState({ shown: true }); this.schedule(); }, 1550);
    }, 320);
  }
  renderVals() {
    const shown = this.state.shown;
    return {
      tableDeg: this.state.deg,
      annOpacity: shown ? 1 : 0,
      annShift: shown ? "translateY(0px)" : "translateY(10px)",
      annDur: shown ? "420ms" : "260ms",
      annEase: shown ? "cubic-bezier(0.05, 0.7, 0.1, 1)" : "cubic-bezier(0.3, 0, 1, 1)",
      annDelay: shown ? "120ms" : "0ms",
      scaleWrapRef: (el) => { this._wrap = el; if (el) setTimeout(() => this.computeScale(), 30); },
      scaleInnerRef: (el) => { this._inner = el; if (el) setTimeout(() => this.computeScale(), 30); }
    };
  }
}
</script>
</body>
</html>
