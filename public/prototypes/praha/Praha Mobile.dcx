      { cat: "SALADS", name: "Caesar Salad", desc: "Crisp romaine, parmesan, croutons & creamy caesar dressing", price: 1395, img: "" },
      { cat: "SALADS", name: "Greek Salad", desc: "Cucumber, tomato, olives, red onion & feta with olive oil", price: 1345, img: "" },
      { cat: "PASTA", name: "Creamy Sundried Tomato Rigatoni", desc: "Rich rigatoni in a creamy sauce with flavorful sundried tomatoes and herbs.", price: 1995, img: "./assets/frame-pasta.png" },
      { cat: "PASTA", name: "Prahas Prawn Linguine Pasta", desc: "Olive oil based spicy tangy clear sauce, prawns & linguine pasta", price: 2045, img: "" },
      { cat: "PASTA", name: "Mac and Cheese", desc: "Pasta in a rich, cheesy béchamel, baked till golden", price: 1595, img: "./assets/frame-mac.png" },
      { cat: "PASTA", name: "Alfredo Pasta", desc: "Tender pasta in a velvety parmesan cream sauce", price: 1745, img: "" },
      { cat: "PASTA", name: "Biang Biang Noodles", desc: "Hand-pulled noodles tossed in a spicy, aromatic sauce", price: 1695, img: "" },
      { cat: "MAIN COURSE", name: "Burrito Bowl", desc: "A bowl of brown rice, purple cabbage, tomato salsa, guacamole, jalapeno garnish with sour cream", price: 1945, img: "./assets/dish-paneer-bowl.png" },
      { cat: "MAIN COURSE", name: "Grilled Chicken Platter", desc: "Herb-marinated chicken breast, roasted vegetables & rice", price: 2145, img: "" },
      { cat: "MAIN COURSE", name: "Beef Steak Platter", desc: "Grilled beef steak, mashed potatoes & peppercorn sauce", price: 2595, img: "" },
      { cat: "PIZZA", name: "Chicken Mushroom & Truffle Oil Pizza", desc: "Homemade white sauce, fresh mushrooms, caramelized onion, black olives, marrow & parmesan cheese, truffle oil", price: 1945, img: "" },
      { cat: "PIZZA", name: "Mediterranean Pizza", desc: "Olives, feta & sundried tomatoes on a thin crust", price: 1895, img: "" },
      { cat: "PIZZA", name: "Buffalo Chicken Pizza", desc: "Tender chicken smothered in a tangy buffalo sauce", price: 1945, img: "" },
      { cat: "PIZZA", name: "Margherita Pizza", desc: "Fresh basil, tomatoes & mozzarella", price: 1595, img: "" },
      { cat: "PIZZA", name: "Prahas Pesto Pizza", desc: "Aromatic basil pesto, mozzarella & cherry tomatoes", price: 1845, img: "" },
      { cat: "PIZZA", name: "Baked Figs with Goat Cheese Pizza", desc: "Baked figs, goat cheese & a honey drizzle", price: 2045, img: "" },
      { cat: "BURGERS", name: "Ja Ja Jamaica Burger", desc: "Grilled spicy chicken, tomatoes, cheese & signature sauce", price: 1845, img: "./assets/frame-burger.png" },
      { cat: "BURGERS", name: "Smashy Beef Burger", desc: "Donut bun, filled with beef, cheese, chipotle & sour cream", price: 1745, img: "./assets/dish-burger.png" },
      { cat: "BURGERS", name: "Classic Cheese Burger", desc: "Beef patty, cheddar, lettuce, tomato & house sauce", price: 1495, img: "" },
      { cat: "SANDWICHES", name: "Prahas Euro Club Sandwich", desc: "Sliced bread, grilled chicken, cheese, lettuce, tomatoes, mayonnaise, Turkey bacon, fried egg, smoke Turkey & pickles", price: 2095, img: "./assets/dish-sandwich.png" },
      { cat: "SANDWICHES", name: "Dynamite Chicken Brioche", desc: "Spicy chicken on a soft brioche bun with dynamite sauce", price: 1745, img: "" },
      { cat: "SANDWICHES", name: "The Muffaleta", desc: "Layers of Italian meats, cheese & a tangy olive salad", price: 1895, img: "" },
      { cat: "SANDWICHES", name: "Country Roast Sandwich", desc: "Roast chicken, fresh vegetables & mustard mayo on sourdough", price: 1695, img: "" },
      { cat: "SANDWICHES", name: "Cheesy Chicken Sandwich", desc: "Tender chicken folded into a creamy cheese sauce", price: 1645, img: "" },
      { cat: "CHIMNEYS", name: "Korean Fried Chimney", desc: "Crispy fried chicken in a savoury-sweet Korean glaze, served in a chimney cone", price: 1995, img: "./assets/wood-dish-chimney.png" },
      { cat: "CHIMNEYS", name: "Prahas Original Chicken", desc: "Grilled chicken breast seasoned with a blend of signature spices", price: 1845, img: "" },
      { cat: "CHIMNEYS", name: "Jalapeno Spice Chicken", desc: "Grilled chicken with jalapeño heat & a creamy finish", price: 1895, img: "" },
      { cat: "CHIMNEYS", name: "Creamy Grilled Tikka", desc: "Yogurt-marinated chicken tikka, grilled & finished in cream", price: 1945, img: "" },
      { cat: "DESSERTS", name: "Lotus Circus", desc: "Signature lotus brownies, with lotus sauce, soft serve ice cream & lotus crumbs", price: 1495, img: "" },
      { cat: "DESSERTS", name: "Chocolate Lava Cake", desc: "Warm chocolate cake with a molten center & vanilla ice cream", price: 1345, img: "" },
      { cat: "DESSERTS", name: "New York Cheesecake", desc: "Creamy baked cheesecake with a buttery biscuit crust", price: 1295, img: "" },
      { cat: "HOT COFFEES", name: "Spanish Latte", desc: "Espresso with condensed milk & steamed milk", price: 745, img: "" },
      { cat: "HOT COFFEES", name: "Hot Chocolate", desc: "Rich melted chocolate, steamed milk & cocoa", price: 795, img: "" },
      { cat: "HOT COFFEES", name: "Cappuccino", desc: "Espresso, steamed milk & a deep layer of foam", price: 695, img: "" },
      { cat: "SHAKES", name: "Lotus Shake", desc: "Lotus biscoff blended with ice cream & milk", price: 995, img: "" },
      { cat: "SHAKES", name: "Oreo Shake", desc: "Crushed oreo cookies blended with ice cream & milk", price: 945, img: "" },
      { cat: "SHAKES", name: "Mango Shake", desc: "Fresh mango blended with milk & a touch of honey", price: 895, img: "" },
      { cat: "REFRESHERS", name: "Passion Fruit Refresher", desc: "Passion fruit, citrus & soda over ice", price: 745, img: "" },
      { cat: "REFRESHERS", name: "Mint Lemonade", desc: "Fresh mint, lemon & soda over ice", price: 695, img: "" },
      { cat: "REFRESHERS", name: "Berry Cooler", desc: "Mixed berries, citrus & soda over ice", price: 745, img: "" }
    ];
  }
  addonData() {
    return [
      { id: "chicken", label: "Add grilled chicken", price: 450 },
      { id: "prawns", label: "Add prawns", price: 650 },
      { id: "cheese", label: "Extra cheese", price: 250 },
      { id: "fries", label: "Side of fries", price: 395 },
      { id: "bread", label: "Garlic bread", price: 345 },
      { id: "coffee", label: "Iced coffee", price: 695 }
    ];
  }
  renderVals() {
    const R = p => (window.__resources && window.__resources[p]) || p;
    const money = n => "Rs. " + n.toLocaleString("en-US");
    const pool = ["./assets/frame-pasta.png", "./assets/frame-frenchtoast.png", "./assets/frame-burger.png", "./assets/frame-mac.png", "./assets/dish-burger.png", "./assets/dish-sandwich.png", "./assets/dish-salad-bowl.png", "./assets/dish-paneer-bowl.png"];
    const all = this.data().map((d, i) => ({ ...d, img: R(d.img || pool[i % pool.length]) }));
    const addonData = this.addonData();
    const q = (this.state.q || "").trim().toLowerCase();
    const cat = this.state.cat;
    const catList = [];
    all.forEach(d => { if (catList.indexOf(d.cat) < 0) catList.push(d.cat); });
    const visible = all.filter(d =>
      (cat === "ALL" || d.cat === cat) &&
      (!q || (d.name + " " + d.desc).toLowerCase().includes(q))
    );
    const added = this.state.added;
    const pickedBy = this.state.pickedBy;
    const noteBy = this.state.noteBy;
    const committed = this.state.committed;
    const sig = (p, n) => p.slice().sort().join("|") + "§" + (n || "").trim();
    const extras = name => {
      const list = pickedBy[name] || [];
      return addonData.reduce((sum, a) => sum + (list.indexOf(a.id) > -1 ? a.price : 0), 0);
    };

    const sections = [];
    let cur = null;
    visible.forEach(d => {
      if (!cur || cur.label !== d.cat) {
        const HEAD = {
          "POPULAR ITEMS": "./uploads/Group 1410103974.png",
          "JAPANESE PANCAKES": "./uploads/Group 1410103958.png",
          "FRENCH TOAST": "./uploads/Group 1410103957.png",
          "STARTERS": "./uploads/Group 1410103959.png",
          "SALADS": "./uploads/Group 1410103961.png",
          "LOADED FRIES": "./uploads/Group 1410103962.png",
          "MAIN COURSE": "./uploads/Group 1410103963.png",
          "PIZZA": "./uploads/Group 1410103964.png",
          "SANDWICHES": "./uploads/Group 1410103965.png",
          "CHIMNEYS": "./uploads/Group 1410103966.png",
          "PASTA": "./uploads/Group 1410103967.png",
          "BURGERS": "./uploads/Group 1410103968.png",
          "DESSERTS": "./uploads/Group 1410103969.png",
          "SHAKES": "./uploads/Group 1410103970.png",
          "HOT COFFEES": "./uploads/Group 1410103971.png",
          "REFRESHERS": "./uploads/Group 1410103972.png"
        };
        cur = { label: d.cat, items: [], headImg: HEAD[d.cat] || "", hasHeadImg: !!HEAD[d.cat], noHeadImg: !HEAD[d.cat] };
        sections.push(cur);
      }
      const qty = added[d.name] || 0;
      cur.items.push({
        name: d.name, desc: d.desc, img: d.img, cat: d.cat,
        priceLabel: money(d.price + extras(d.name)),
        qty: String(qty), inCart: qty > 0, notInCart: qty === 0,
        open: (e) => { if (e && e.preventDefault) e.preventDefault(); this.setState({ open: d.name }); }
      });
    });

    const openName = this.state.open;
    const item = all.filter(d => d.name === openName)[0] || null;
    const key = openName || "";
    const picked = pickedBy[key] || [];
    const note = noteBy[key] || "";
    const setPicked = (fn) => this.setState(s => ({ pickedBy: { ...s.pickedBy, [key]: fn(s.pickedBy[key] || []) } }));
    const addons = addonData.map(a => ({
      id: a.id,
      optionLabel: (picked.indexOf(a.id) > -1 ? "✓  " : "") + a.label + "  +Rs. " + a.price,
      toggle: () => setPicked(list => list.indexOf(a.id) > -1 ? list.filter(x => x !== a.id) : list.concat([a.id]))
    }));
    const addedQty = item ? (added[item.name] || 0) : 0;
    const unitPrice = item ? item.price + extras(item.name) : 0;

    const cartNames = Object.keys(added).filter(n => added[n] > 0);
    const cartTotal = cartNames.reduce((sum, n) => {
      const d = all.filter(x => x.name === n)[0];
      return sum + (d ? (d.price + extras(n)) * added[n] : 0);
    }, 0);
    const cartCount = cartNames.reduce((a, n) => a + added[n], 0);

    return {
      tableDeg: this.state.deg,
      annOpacity: this.state.shown ? 1 : 0,
      q: this.state.q,
      onSearch: (e) => { const v = e.target.value; this.setState({ q: v }); },
      cats: [{ label: "ALL", key: "ALL" }].concat(catList.map(c => ({ label: c, key: c }))).map(c => ({
        label: c.label,
        on: cat === c.key,
        off: cat !== c.key,
        pick: (e) => { if (e && e.preventDefault) e.preventDefault(); this.setState({ cat: c.key }); }
      })),
      sections,
      sheetOpen: !!item,
      sel: item ? { name: item.name, desc: item.desc, cat: item.cat, img: item.img } : { name: "", desc: "", cat: "", img: "" },
      closeSheet: (e) => { if (e && e.preventDefault) e.preventDefault(); this.setState({ open: null }); },
      addons,
      addonSelect: "",
      addonSummary: picked.length ? addonData.filter(a => picked.indexOf(a.id) > -1).map(a => a.label.replace(/^Add /, "")).join(", ") : "Select add-ons",
      addonSummaryColor: picked.length ? "#14110F" : "#A9A198",
      onPickAddon: (e) => {
        const id = e.target.value;
        if (!id) return;
        setPicked(list => list.indexOf(id) > -1 ? list.filter(x => x !== id) : list.concat([id]));
      },
      noteVal: note,
      onNote: (e) => { const v = e.target.value; this.setState(s => ({ noteBy: { ...s.noteBy, [key]: v } })); },
      unitPriceLabel: money(unitPrice),
      addedQty: String(addedQty),
      notAdded: addedQty === 0,
      isDirty: addedQty > 0 && committed[key] !== undefined && committed[key] !== sig(picked, note),
      isAddedClean: addedQty > 0 && (committed[key] === undefined || committed[key] === sig(picked, note)),
      addToOrder: (e) => {
        if (e && e.preventDefault) e.preventDefault();
        this.setState(s => ({
          added: { ...s.added, [key]: (s.added[key] || 0) + 1 },
          committed: { ...s.committed, [key]: sig(picked, note) }
        }));
      },
      updateOrder: (e) => {
        if (e && e.preventDefault) e.preventDefault();
        this.setState(s => ({ committed: { ...s.committed, [key]: sig(picked, note) } }));
      },
      addedInc: (e) => {
        if (e && e.preventDefault) e.preventDefault();
        this.setState(s => ({ added: { ...s.added, [key]: Math.min(20, (s.added[key] || 0) + 1) } }));
      },
      addedDec: (e) => {
        if (e && e.preventDefault) e.preventDefault();
        this.setState(s => ({ added: { ...s.added, [key]: Math.max(0, (s.added[key] || 0) - 1) } }));
      },
      cartHasItems: cartCount > 0,
      cartCountLabel: cartCount === 1 ? "1 ITEM" : cartCount + " ITEMS",
      cartTotalLabel: money(cartTotal),
      goCheckout: (e) => {
        try {
          localStorage.setItem("praha-cart", JSON.stringify(cartNames.map(n => {
            const d = all.filter(x => x.name === n)[0] || {};
            return { name: n, img: d.img, unit: (d.price || 0) + extras(n), qty: added[n] };
          })));
        } catch (err) {}
        if (this.props.onCheckout) { if (e && e.preventDefault) e.preventDefault(); this.props.onCheckout(); }
      }
    };
  }
}
</script>
</body>
</html>
